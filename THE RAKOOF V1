-- ADVANCED OPTIMIZED TARGET NAMETAGS (Chips, Slushie, Burger, Coffee, Jose, Ducks)
-- ========================================================
local targetTagsEnabled = false
local trackedNametags = {}

local function isTargetItem(name)
    name = name:lower()
    return name:find("chip") or name:find("slushie") or name:find("burger") or name:find("coffee") or name:find("jose") or name:find("duck")
end

local function attachNametag(obj)
    if trackedNametags[obj] then return end
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
    if isNokia(obj) then return end
    
    if isTargetItem(obj.Name) then
        local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
        if targetPart and not targetPart:FindFirstChild("OptimizedTargetTag") then
            local bg = Instance.new("BillboardGui")
            bg.Name = "OptimizedTargetTag"
            bg.Size = UDim2.new(0, 120, 0, 40)
            bg.StudsOffset = Vector3.new(0, 2.5, 0)
            bg.AlwaysOnTop = true
            bg.Parent = targetPart
            
            local lbl = Instance.new("TextLabel", bg)
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = "📌 " .. obj.Name
            lbl.TextColor3 = Color3.fromRGB(0, 255, 200)
            lbl.TextStrokeTransparency = 0
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 12
            
            trackedNametags[obj] = bg
            
            -- Instant removal when item is destroyed/picked up (Zero lag cleanup)
            obj.Destroying:Connect(function()
                if trackedNametags[obj] then
                    trackedNametags[obj]:Destroy()
                    trackedNametags[obj] = nil
                end
            end)
        end
    end
end

local descendantConnection = nil

TargetTagBtn.Activated:Connect(function()
    targetTagsEnabled = not targetTagsEnabled
    TargetTagBtn.Text = targetTagsEnabled and "🏷️ TARGET NAMETAGS: ON" or "🏷️ TARGET NAMETAGS: OFF"
    TargetTagBtn.BackgroundColor3 = targetTagsEnabled and Color3.fromRGB(220, 150, 0) or Color3.fromRGB(30, 30, 40)
    TargetTagStroke.Color = targetTagsEnabled and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(80, 80, 100)
    
    if targetTagsEnabled then
        -- Initial scan (optimized chunk)
        task.spawn(function()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if targetTagsEnabled then
                    attachNametag(obj)
                else
                    break
                end
            end
        end)
        
        -- Listen live for spawned target items instantly without laggy loops
        descendantConnection = Workspace.DescendantAdded:Connect(function(obj)
            if targetTagsEnabled then
                task.spawn(function()
                    task.wait(0.1) -- small buffer for model loading
                    attachNametag(obj)
                end)
            end
        end)
    else
        if descendantConnection then
            descendantConnection:Disconnect()
            descendantConnection = nil
        end
        -- Clear all existing active tags instantly
        for obj, gui in pairs(trackedNametags) do
            if gui then gui:Destroy() end
        end
        trackedNametags = {}
    end
end)

-- Teleport to Me Logic (excluding Nokia)
BringBtn.Activated:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local targetCFrame = hrp.CFrame * CFrame.new(0, 0, -3)
        for _, folder in ipairs(getGiversFolders()) do
            for _, category in ipairs(folder:GetChildren()) do
                for _, item in ipairs(category:GetChildren()) do
                    if not isNokia(item) then
                        if item:IsA("BasePart") then
                            item.CFrame = targetCFrame
                        elseif item:IsA("Model") then
                            item:PivotTo(targetCFrame)
                        elseif item:IsA("Folder") then
                            for _, subItem in ipairs(item:GetChildren()) do
                                if not isNokia(subItem) then
                                    if subItem:IsA("BasePart") then
                                        subItem.CFrame = targetCFrame
                                    elseif subItem:IsA("Model") then
                                        subItem:PivotTo(targetCFrame)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end)

