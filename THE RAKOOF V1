local function findTheRakeModel()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name == "THE_RAKE" or obj.Name:lower():find("rake") or obj.Name:lower():find("rakoof")) then
            local p = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
            if p then return obj, p end
        end
    end
    return nil, nil
end

-- Remote Search Helper from Screenshot 2 & 3
local function findRemote(name)
    for _, obj in ipairs(game:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent")) and obj.Name == name then
            return obj
        end
    end
    return nil
end

