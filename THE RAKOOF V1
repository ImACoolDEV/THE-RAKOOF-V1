-- Robust Givers folder finder
local function getGiversFolders()
    local folders = {}
    local filter = Workspace:FindFirstChild("Filter")
    if filter then
        local givers = filter:FindFirstChild("Givers")
        if givers then table.insert(folders, givers) end
    end
    local directGivers = Workspace:FindFirstChild("Givers")
    if directGivers then table.insert(folders, directGivers) end
    
    if #folders == 0 then
        for _, desc in ipairs(Workspace:GetDescendants()) do
            if desc:IsA("Folder") and desc.Name == "Givers" then
                table.insert(folders, desc)
            end
        end
    end
    return folders
end

local function isNokia(item)
    return item.Name:lower():find("nokia") ~= nil
end

