-- THE RAKOOF V1 - Standalone Givers ESP (Targeting Models/Parts Inside Folders) & Utility Remotes
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local ParentGui = (pcall(function() return gethui() end) and gethui()) or CoreGui

-- Cleanup previous instance if running
if ParentGui:FindFirstChild("TheRakoofGui") then
    ParentGui.TheRakoofGui:Destroy()
end

local ScreenGui = Instance.new("ScreenGui", ParentGui)
ScreenGui.Name = "TheRakoofGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.DisplayOrder = 999

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
MainFrame.Size = UDim2.new(0, 360, 0, 260)
MainFrame.Position = UDim2.new(0.5, 0, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)
local MainStroke = Instance.new("UIStroke", MainFrame)
MainStroke.Thickness = 2
MainStroke.Color = Color3.fromRGB(255, 170, 0)

-- Draggable UI
local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Title Bar
local TitleBar = Instance.new("TextLabel", MainFrame)
TitleBar.Size = UDim2.new(1, 0, 0, 38)
TitleBar.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
TitleBar.Text = "🔥 THE RAKOOF V1 - GIVERS ESP & UTILITIES"
TitleBar.TextColor3 = Color3.fromRGB(255, 200, 50)
TitleBar.Font = Enum.Font.GothamBold
TitleBar.TextSize = 11
Instance.new("UICorner", TitleBar).CornerRadius = UDim.new(0, 12)

local CloseBtn = Instance.new("TextButton", MainFrame)
CloseBtn.Size = UDim2.new(0, 24, 0, 24)
CloseBtn.Position = UDim2.new(1, -30, 0, 7)
CloseBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextSize = 10
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)
CloseBtn.Activated:Connect(function() ScreenGui:Destroy() end)

-- Remote Finder Helper
local function findRemote(name)
    for _, obj in ipairs(game:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent")) and obj.Name == name then
            return obj
        end
    end
    return nil
end

-- Toggle Buttons
local function createToggle(text, yPos)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.88, 0, 0, 38)
    btn.Position = UDim2.new(0.06, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.Text = text .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(80, 80, 100)
    return btn, stroke
end

local GiversBtn, GiversStroke = createToggle("🍔 GIVERS ESP", 50)
local StaminaBtn, StaminaStroke = createToggle("⚡ MAX STAMINA (ChangeStamina)", 100)
local HealBtn, HealStroke = createToggle("💚 AUTO HEAL (HealPlayer)", 150)

-- State Variables
local giversESP = false
local maxStamina = false
local autoHeal = false

local function updateBtn(btn, stroke, state, text)
    btn.Text = text .. (state and ": ON" or ": OFF")
    btn.BackgroundColor3 = state and Color3.fromRGB(220, 150, 0) or Color3.fromRGB(30, 30, 40)
    btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
    stroke.Color = state and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(80, 80, 100)
end

-- 1. Givers ESP Logic (Targeting models/parts inside subfolders)
GiversBtn.Activated:Connect(function()
    giversESP = not giversESP
    updateBtn(GiversBtn, GiversStroke, giversESP, "🍔 GIVERS ESP")
end)

task.spawn(function()
    while true do
        if giversESP then
            pcall(function()
                local giversFolder = Workspace:FindFirstChild("Givers")
                if giversFolder then
                    for _, subFolder in ipairs(giversFolder:GetChildren()) do
                        for _, item in ipairs(subFolder:GetDescendants()) do
                            if item:IsA("Model") or item:IsA("BasePart") then
                                local hl = item:FindFirstChild("RakoofGiverESP")
                                if not hl then
                                    hl = Instance.new("Highlight", item)
                                    hl.Name = "RakoofGiverESP"
                                    hl.FillColor = Color3.fromRGB(255, 200, 0)
                                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(1)
        else
            pcall(function()
                local giversFolder = Workspace:FindFirstChild("Givers")
                if giversFolder then
                    for _, subFolder in ipairs(giversFolder:GetChildren()) do
                        for _, item in ipairs(subFolder:GetDescendants()) do
                            if item:IsA("Model") or item:IsA("BasePart") then
                                local hl = item:FindFirstChild("RakoofGiverESP")
                                if hl then hl:Destroy() end
                            end
                        end
                    end
                end
            end)
            task.wait(1)
        end
    end
end)

-- 2. ChangeStamina Remote Event
StaminaBtn.Activated:Connect(function()
    maxStamina = not maxStamina
    updateBtn(StaminaBtn, StaminaStroke, maxStamina, "⚡ MAX STAMINA (ChangeStamina)")
end)

task.spawn(function()
    while true do
        if maxStamina then
            local changeStaminaRE = findRemote("ChangeStamina")
            if changeStaminaRE then
                pcall(function() changeStaminaRE:FireServer(100, 100) end)
            end
            task.wait(0.2)
        else
            task.wait(0.5)
        end
    end
end)

-- 3. HealPlayer Remote Event
HealBtn.Activated:Connect(function()
    autoHeal = not autoHeal
    updateBtn(HealBtn, HealStroke, autoHeal, "💚 AUTO HEAL (HealPlayer)")
end)

task.spawn(function()
    while true do
        if autoHeal then
            local healRE = findRemote("HealPlayer")
            if healRE then
                pcall(function() healRE:FireServer(LocalPlayer, 100) end)
            end
            task.wait(0.2)
        else
            task.wait(0.5)
        end
    end
end)
