-- Helper to find Givers folder inside Filter or Workspace
local function getGiversFolder()
    local filter = Workspace:FindFirstChild("Filter")
    if filter and filter:FindFirstChild("Givers") then
        return filter.Givers
    end
    return Workspace:FindFirstChild("Givers")
end

-- ESP Logic
local giversESPEnabled = false
ESPBtn.Activated:Connect(function()
    giversESPEnabled = not giversESPEnabled
    ESPBtn.Text = giversESPEnabled and "🍔 GIVERS ESP: ON" or "🍔 GIVERS ESP: OFF"
    ESPBtn.BackgroundColor3 = giversESPEnabled and Color3.fromRGB(220, 150, 0) or Color3.fromRGB(30, 30, 40)
    ESPStroke.Color = giversESPEnabled and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(80, 80, 100)
end)

task.spawn(function()
    while true do
        if giversESPEnabled then
            pcall(function()
                local giversFolder = getGiversFolder()
                if giversFolder then
                    for _, category in ipairs(giversFolder:GetChildren()) do
                        for _, item in ipairs(category:GetChildren()) do
                            if (item:IsA("BasePart") or item:IsA("Model")) and not item:FindFirstChild("GiverESP") then
                                local hl = Instance.new("Highlight", item)
                                hl.Name = "GiverESP"
                                hl.FillColor = Color3.fromRGB(255, 200, 0)
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            end
                        end
                    end
                end
            end)
            task.wait(1)
        else
            pcall(function()
                local giversFolder = getGiversFolder()
                if giversFolder then
                    for _, category in ipairs(giversFolder:GetChildren()) do
                        for _, item in ipairs(category:GetChildren()) do
                            local hl = item:FindFirstChild("GiverESP")
                            if hl then hl:Destroy() end
                        end
                    end
                end
            end)
            task.wait(1)
        end
    end
end)

-- Teleport to Me Logic
BringBtn.Activated:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local giversFolder = getGiversFolder()
        if giversFolder then
            for _, category in ipairs(giversFolder:GetChildren()) do
                for _, item in ipairs(category:GetChildren()) do
                    if item:IsA("BasePart") then
                        item.CFrame = hrp.CFrame * CFrame.new(0, 0, -3)
                    elseif item:IsA("Model") then
                        if item.PrimaryPart then
                            item:SetPrimaryPartCFrame(hrp.CFrame * CFrame.new(0, 0, -3))
                        else
                            local part = item:FindFirstChildWhichIsA("BasePart")
                            if part then part.CFrame = hrp.CFrame * CFrame.new(0, 0, -3) end
                        end
                    end
                end
            end
        end
    end)
end)

